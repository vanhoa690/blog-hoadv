---
// src/layouts/Layout.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{Astro.props.title || "Blog của tôi"}</title>
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        margin: 0;
        padding: 0;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <Header />

    <main class="container">
      <slot />
    </main>

    <Footer />

    <style>
      .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 20px;
      }
    </style>
  </body>
</html>
