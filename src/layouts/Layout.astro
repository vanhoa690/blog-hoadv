---
// src/layouts/Layout.astro
import '~/assets/styles/tailwind.css';
import NewHeader from '../components/NewHeader.astro';
import NewFooter from '~/components/NewFooter.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
export const headerData = {
  links: [
    {
      text: 'Home',
      href: '/',
    },
  ],
};
export const footerData = {
  links: [
    {
      title: 'Category',
      links: [
        { text: 'Javascript', href: '#' },
        { text: 'NodeJs', href: '#' },
        { text: 'ReactJS', href: '#' },
      ],
    },
    {
      title: 'NodeJS',
      links: [{ text: 'NodeJS API', href: '#' }],
    },
    {
      title: 'ReactJS',
      links: [{ text: 'Typescript', href: '#' }],
    },
    {
      title: 'Company',
      links: [
        { text: 'About', href: '#' },
        { text: 'Blog', href: '#' },
        { text: 'Contact', href: '#' },
      ],
    },
  ],
  secondaryLinks: [
    { text: 'Terms', href: '/terms' },
    { text: 'Privacy Policy', href: '/privacy' },
  ],
  socialLinks: [
    { ariaLabel: 'X', icon: 'tabler:brand-x', href: '#' },
    { ariaLabel: 'Instagram', icon: 'tabler:brand-instagram', href: '#' },
    { ariaLabel: 'Facebook', icon: 'tabler:brand-facebook', href: '#' },
    { ariaLabel: 'Github', icon: 'tabler:brand-github', href: 'https://github.com/vanhoa690' },
  ],
  footNote: `
    Made by <a class="text-blue-600 underline dark:text-muted" href="https://github.com/vanhoa690"> Hoadv</a> · All rights reserved.
  `,
};
---

<!doctype html>
<html lang="vi" class="2xl:text-[20px]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{Astro.props.title || 'Blog của tôi'}</title>
    <style is:inline>
      :root {
        --aw-font-sans: 'Inter Variable';
        --aw-font-serif: 'Inter Variable';
        --aw-font-heading: 'Inter Variable';

        --aw-color-primary: rgb(1 97 239);
        --aw-color-secondary: rgb(1 84 207);
        --aw-color-accent: rgb(109 40 217);

        --aw-color-text-heading: rgb(0 0 0);
        --aw-color-text-default: rgb(16 16 16);
        --aw-color-text-muted: rgb(16 16 16 / 66%);
        --aw-color-bg-page: rgb(255 255 255);

        --aw-color-bg-page-dark: rgb(3 6 32);

        ::selection {
          background-color: lavender;
        }
      }

      .dark {
        --aw-font-sans: 'Inter Variable';
        --aw-font-serif: 'Inter Variable';
        --aw-font-heading: 'Inter Variable';

        --aw-color-primary: rgb(1 97 239);
        --aw-color-secondary: rgb(1 84 207);
        --aw-color-accent: rgb(109 40 217);

        --aw-color-text-heading: rgb(247, 248, 248);
        --aw-color-text-default: rgb(229 236 246);
        --aw-color-text-muted: rgb(229 236 246 / 66%);
        --aw-color-bg-page: rgb(3 6 32);

        ::selection {
          background-color: black;
          color: snow;
        }
      }
    </style>
  </head>
  <body class="antialiased text-default bg-page tracking-tight">
    <NewHeader {...headerData} />

    <main class="container">
      <slot />
    </main>

    <NewFooter {...footerData} />

    <BasicScripts />
  </body>
</html>
