---
// src/pages/posts/[slug].astro
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Hàm bắt buộc để tạo static paths cho dynamic routes
export async function getStaticPaths() {
  const posts = await getCollection("posts");

  // Filter chỉ lấy bài không phải draft
  const publishedPosts = posts.filter((post) => !post.data.draft);

  // Trả về array of objects với params cho mỗi slug
  return publishedPosts.map((post) => ({
    params: {
      slug: post.data.slug,
    },
    props: {
      post,
    },
  }));
}

// Lấy post từ Astro.props (được truyền từ getStaticPaths)
const { post } = Astro.props;

// Render markdown content
---

<Layout title={`${post.data.title} - Blog của tôi`}>
  <article style="max-width: 800px; margin: 0 auto; padding: 2rem 0;">
    <header style="margin-bottom: 3rem;">
      <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">
        {post.data.title}
      </h1>

      <div
        style="display: flex; justify-content: space-between; align-items: center; color: #718096; margin-bottom: 2rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 1rem;"
      >
        <div>
          <span>Tác giả: {post.data.author}</span>
          <span style="margin-left: 1rem;">
            Ngày đăng: {new Date(post.data.date).toLocaleDateString("vi-VN")}
          </span>
        </div>

        <div style="display: flex; gap: 0.5rem;">
          {
            post.data.tags.map((tag: string) => (
              <span style="background: #e2e8f0; color: #4a5568; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.875rem;">
                #{tag}
              </span>
            ))
          }
        </div>
      </div>

      <p
        style="font-size: 1.25rem; color: #4a5568; font-style: italic; padding: 1rem; background: #f7fafc; border-left: 4px solid #3182ce;"
      >
        {post.data.description}
      </p>
    </header>

    <div style="line-height: 1.8;"></div>

    <footer
      style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #e2e8f0;"
    >
      <div style="display: flex; justify-content: space-between;">
        <a href="/" style="color: #3182ce;">← Quay về trang chủ</a>
        <button
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          style="background: #e2e8f0; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer;"
        >
          Lên đầu trang ↑
        </button>
      </div>
    </footer>
  </article>
</Layout>
